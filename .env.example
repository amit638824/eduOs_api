NODE_ENV=development
PORT=3000

# ============================================================
# ENVIRONMENT TOGGLE: true = LIVE / PRODUCTION, false = LOCAL
# - IS_LIVE=true  => Live DB & Prod URLs
# - IS_LIVE=false => Local DB & Local URLs
# ============================================================
IS_LIVE=false

# ------------------------------------------------------------
# LIVE DATABASE CONFIGURATION (Active when IS_LIVE=true)
# ------------------------------------------------------------
DB_LIVE_TYPE=mysql
DB_LIVE_HOST=s12078.use1.stableserver.net
DB_LIVE_PORT=3306
DB_LIVE_USER=techwagger_mindsprint_user
DB_LIVE_PASSWORD=your_live_db_password
DB_LIVE_NAME=techwagger_mindsprint_db
DB_LIVE_SSL=false
DB_LIVE_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------
# LOCAL DATABASE CONFIGURATION (Active when IS_LIVE=false)
# ------------------------------------------------------------
DB_LOCAL_TYPE=mysql
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=
DB_LOCAL_NAME=edutech
DB_LOCAL_SSL=false
DB_LOCAL_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_min_64_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_min_64_chars
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=24h

# CORS — comma-separated browser origins (no trailing slash)
# Production example:
# CORS_ORIGINS=https://onlineexam.techwagger.com,https://www.onlineexam.techwagger.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Bcrypt
BCRYPT_ROUNDS=12

# App
APP_NAME=Mindsprint
TRUST_PROXY=1

# Frontend URLs (password reset / welcome / credentials emails)
# Local default when NODE_ENV=development:
FRONTEND_URL_LOCAL=http://localhost:5173
# Production default when NODE_ENV=production:
FRONTEND_URL_PROD=https://onlineexam.techwagger.com
# Override active link base (optional). If empty, picks LOCAL or PROD from NODE_ENV.
# For real emails from local API, set this to PROD so links are not localhost:
FRONTEND_URL=http://localhost:5173

# Email branding (absolute URLs — email clients cannot load localhost images)
EMAIL_ASSET_BASE=https://onlineexam.techwagger.com
LOGO_URL=https://mindsprint.techwagger.com/img/logo/techwagger-logo.png
EMAIL_CTA_DASHBOARD_PNG=https://onlineexam.techwagger.com/img/email/go-to-dashboard.png
EMAIL_CTA_RESET_PNG=https://onlineexam.techwagger.com/img/email/reset-password.png

# SMTP (Office365 / Gmail / etc.)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=your_email@domain.com
BCC_EMAILS=admin@domain.com

# Razorpay (test keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# OpenAI (question generation). The key stays on the server and is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
